rules_version = '2';

// ROBLOC Firestore security rules.
// Paste this into Firebase console → Firestore Database → Rules, then Publish.
//
// Kept simple on purpose so new game features never need a rules change:
//   - anyone signed in with Google can create and save their own player
//   - nobody can change another player's save
//   - special roles and their bonuses (owner = Trevor, siwei = Si Wei) come only from roles/{uid},
//     which is created by hand in the console and can't be written by players
//
// Data model
//   users/{uid}  one document per Google account
//   roles/{uid}  role, moneyBase, coinsBase, pointsBase, playedBase, winsBase, winChance (all strings)
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }

    function rolePath(uid) { return /databases/$(database)/documents/roles/$(uid); }
    function roleStr(uid, k) { return string(get(rolePath(uid)).data.get(k, '0')); }
    // The role fields in a player's save must match roles/{uid}, or be plain-player defaults when there is no role.
    function roleFieldsOk(uid, d) {
      return (exists(rolePath(uid))
               && d.get('role', 'player') == get(rolePath(uid)).data.role
               && d.get('moneyBase', '0') == roleStr(uid, 'moneyBase')
               && d.get('coinsBase', '0') == roleStr(uid, 'coinsBase')
               && d.get('pointsBase', '0') == roleStr(uid, 'pointsBase')
               && d.get('playedBase', '0') == roleStr(uid, 'playedBase')
               && d.get('winsBase', '0') == roleStr(uid, 'winsBase')
               && d.get('winChance', '0') == roleStr(uid, 'winChance'))
          || (!exists(rolePath(uid))
               && d.get('role', 'player') == 'player' && d.get('moneyBase', '0') == '0' && d.get('coinsBase', '0') == '0'
               && d.get('pointsBase', '0') == '0' && d.get('playedBase', '0') == '0'
               && d.get('winsBase', '0') == '0' && d.get('winChance', '0') == '0');
    }

    match /roles/{uid} {
      allow read: if isSelf(uid);
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if isSelf(uid) && roleFieldsOk(uid, request.resource.data);
      allow delete: if false;
    }
  }
}
